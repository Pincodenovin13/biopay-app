# ==============================================================================
# BioPay Platform - Environment Configuration Template
# Iranian VPS & Middle-East Deployment
# ==============================================================================

# Application Runtime
NODE_ENV="production"
PORT=3000
APP_URL="https://biopay.me"
NEXTAUTH_URL="https://biopay.me"
NEXTAUTH_SECRET="your-super-strong-jwt-and-session-secret-min-32-chars-hex"
CSRF_SECRET="your-cryptographically-random-csrf-secret-key-32-bytes"

# PostgreSQL 16 Database
# format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://biopay_user:SecurePasswordVPS2026!@localhost:5432/biopay_db?schema=public"

# SMS OTP Provider - Kavenegar (Iran Local Routing)
KAVENEGAR_API_KEY="your_kavenegar_api_key_here"
KAVENEGAR_SENDER="10008663"
KAVENEGAR_OTP_TEMPLATE="biopay-verify"

# International Email OTP & Notifications (Resend / SMTP)
RESEND_API_KEY="re_sample_key_for_international_merchants"
EMAIL_FROM="BioPay Security <security@biopay.me>"
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@biopay.me"
SMTP_PASSWORD="your-smtp-password"

# Telegram Bot Integration (Merchant Verification & Payout Notices)
TELEGRAM_BOT_TOKEN="7123456789:AAEjSampleTelegramBotTokenHere"
TELEGRAM_CHANNEL_ID="@BioPayPayouts"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# Payment Gateways (Zarinpal Sandbox & Direct Merchant Settlement)
ZARINPAL_MERCHANT_ID="4ced0a1e-4ad8-4309-9668-3ea3ae8e8897" # Use sample for sandbox
ZARINPAL_SANDBOX="true"
PAYMENT_CALLBACK_URL="https://biopay.me/api/payments/callback"

# File Upload Storage (Local VPS with Sharp WebP Compression)
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_BYTES=2097152 # 2 MB strict limit
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp"

# Rate Limiter Configuration (Memory / Redis)
RATE_LIMIT_OTP_HOURLY=3
RATE_LIMIT_WINDOW_SECONDS=3600

# USDT TRC20 Gateway (TronGrid API - Part 2 preparation)
TRONGRID_API_URL="https://api.trongrid.io"
TRONGRID_API_KEY="your-trongrid-api-key"
MASTER_USDT_TRC20_WALLET="TLyEzSampleTronGridMasterWalletAddress2026"
